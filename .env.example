# ==============================================================================
# PinIt ScamCheck AI — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# Replace all placeholder values with cryptographically secure random strings.
# ==============================================================================

# Application & Gateway
NODE_ENV=production
PORT=4000
CORS_ORIGIN=http://localhost,http://localhost:80

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=scamcheck
POSTGRES_PASSWORD=replace_with_secure_postgres_password_in_production
POSTGRES_DB=scamcheck_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Redis & Background Queue (BullMQ)
REDIS_PASSWORD=replace_with_secure_redis_password_in_production
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Inter-Service Gateway Secrets
ADMIN_API_KEY=replace_with_secure_admin_api_key_min_32_chars
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars_in_production
JWT_EXPIRES_IN=7d

# Antivirus Daemon (ClamAV)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# External AI & Threat Intelligence APIs (Optional)
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=

# Data Retention Policy (GDPR / PDPA Compliance)
DATA_RETENTION_DAYS=90
