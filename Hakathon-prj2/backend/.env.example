# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database Configuration (SQLite default for local, PostgreSQL for docker/prod)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# JWT Authentication
# In production, this MUST be set to a cryptographically secure random string (minimum 32 characters)
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars_in_production
JWT_EXPIRES_IN=15m

# Administrative AI Engine Secret
ADMIN_API_KEY=replace_with_secure_admin_api_key_min_32_chars

# Data Retention Policy (GDPR / PDPA Compliance)
DATA_RETENTION_DAYS=90

# File Upload Limits
MAX_FILE_SIZE_BYTES=26214400 # 25MB
UPLOAD_TEMP_DIR="./storage/temp"

# Queue / Redis Configuration
# When REDIS_URL is empty or unreachable, backend runs in zero-dependency in-process async queue mode
REDIS_URL=redis://localhost:6379

# Antivirus Engine (ClamAV)
# When ClamAV is offline, simulated EICAR & static heuristics seamlessly fallback
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# External Threat Intelligence APIs (Optional)
VIRUSTOTAL_API_KEY=

# Rate Limiting & Abuse Protection
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_TEXT_MAX=30      # 30 text analyses per minute per client
RATE_LIMIT_URL_MAX=20       # 20 URL scans per minute per client
RATE_LIMIT_FILE_MAX=10      # 10 file scans per minute per client
RATE_LIMIT_AI_MAX=15        # 15 AI explanation requests per 15 minutes per client
RATE_LIMIT_REPORTS_MAX=10   # 10 community reports per 15 minutes per client
RATE_LIMIT_FEEDBACK_MAX=20  # 20 feedback submissions per 15 minutes per client

# Payload & Request Size Controls
MAX_TEXT_LENGTH_CHARS=10000 # Max characters for raw text analysis
MAX_JSON_BODY_BYTES=1048576 # 1MB max JSON request body

# Execution & Processing Timeouts
REQUEST_TIMEOUT_MS=30000       # 30s HTTP request timeout
AI_REQUEST_TIMEOUT_MS=10000    # 10s AI engine timeout
FILE_ANALYSIS_TIMEOUT_MS=15000 # 15s file inspection timeout
