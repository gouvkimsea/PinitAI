# =========================================================================
# PinIt ScamCheck AI — Production Environment Variable Configuration
# =========================================================================
# Copy this file to '.env' before launching production containers:
#   cp .env.example .env
#
# IMPORTANT: Generate strong random secrets before running in production!
# E.g., using: openssl rand -base64 32
# =========================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=scamcheck_db
POSTGRES_USER=scamcheck
POSTGRES_PASSWORD=replace_with_strong_random_postgres_password_32_chars

# Redis Broker Configuration
REDIS_PASSWORD=replace_with_strong_random_redis_password_32_chars

# Internal AI Engine & Administrative Access Key
ADMIN_API_KEY=replace_with_strong_random_admin_key_32_chars

# Node.js Express Backend Secret for JWT Authentication
JWT_SECRET=replace_with_strong_random_jwt_secret_at_least_32_chars

# External AI Provider (Google Gemini for explanation reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# External Threat Intelligence (Optional VirusTotal API Key)
VIRUSTOTAL_API_KEY=

# Public Domain / CORS Configuration
CORS_ORIGIN=http://localhost,http://localhost:5173,http://localhost:5000
